# ============================================================
# Univers Ride — Variables d'environnement (Hostinger hPanel)
# ============================================================
# A configurer dans hPanel > Sites web > [votre app Node.js] > Variables d'environnement
# (PAS besoin d'un fichier .env sur le serveur : hPanel les injecte au runtime).
# Ce fichier sert de modèle/local pour le développement (cp .env.example .env).

# --- Base de données MySQL --------------------------------------------------
# Option A (recommandée) : une seule URL de connexion
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
# - Si l'app Node tourne SUR le même compte Hostinger que la base : HOTE = localhost
# - Si la base est distante (Remote MySQL activé) : HOTE = l'hôte donné par hPanel
#   (ex: sql608.main-hosting.eu), voir hPanel > Bases de données > MySQL distant
DATABASE_URL=mysql://u123456789_ride:MotDePasseFort123!@localhost:3306/u123456789_ride

# Option B : variables séparées (utilisées uniquement si DATABASE_URL est vide)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_ride
DB_USER=u123456789_ride
DB_PASSWORD=MotDePasseFort123!

# --- Sécurité / Authentification admin --------------------------------------
JWT_SECRET=remplacer-par-un-secret-long-et-aleatoire
ADMIN_EMAIL=admin@universride.net
ADMIN_PASSWORD=ChangeMe-UniversRide-2026!

# --- Réseau ------------------------------------------------------------------
# Hostinger assigne automatiquement PORT pour les Node.js Web Apps : ne pas
# forcer une valeur en production sauf test local.
PORT=8080
NODE_ENV=production

# --- Stockage des fichiers uploadés (médiathèque admin) ---------------------
# Chemin ABSOLU en dehors du dossier de build pour survivre aux redéploiements
# (ex via SSH sur un plan Business : /home/u123456789/uploads)
UPLOADS_DIR=/home/u123456789/uploads

# --- Clé API tierce utilisée par le FRONTEND (build-time) -------------------
# Google Maps (client/src/components/Map.tsx). Les variables VITE_* sont
# injectées DANS le bundle JS au moment du "npm run build" (pas au runtime) :
# elle doit donc être présente dans hPanel AVANT de lancer/relancer le build,
# sinon la carte reste désactivée tant qu'un nouveau build n'est pas déclenché.
VITE_GOOGLE_MAPS_API_KEY=

# Non requis : VITE_OAUTH_PORTAL_URL / VITE_APP_ID référencés dans
# client/src/const.ts (fonction getLoginUrl) sont du code mort, non appelé
# nulle part dans l'app — inutile de leur donner une valeur.
